+    private static func drawComicZ(in ctx: CGContext, center: CGPoint, size: CGFloat, alpha: CGFloat, ink: NSColor) {
+        guard alpha > 0.02 else { return }
+        ctx.saveGState()
+        ctx.setAlpha(alpha)
