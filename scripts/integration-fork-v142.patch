+            if (deskFade > 0.01f && loafS > 0.02f) {
+                drawWithLayerAlpha(g, deskFade * loafS, [&](Graphics& lg) {
+                    GraphicsState s = lg.Save();
+                    lg.TranslateTransform(0.0f, scruffS * 20.0f);
