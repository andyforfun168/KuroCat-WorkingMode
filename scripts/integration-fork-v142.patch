+        ctx.move(to: CGPoint(x: 844, y: 574)); ctx.addLine(to: CGPoint(x: 855, y: 594))
+        ctx.move(to: CGPoint(x: 872, y: 562)); ctx.addLine(to: CGPoint(x: 884, y: 580))
