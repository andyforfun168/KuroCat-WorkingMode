+            PointF p2 = lp({ 348.0f, 376.0f }, { 282.0f, 484.0f });
+            gp.AddBezier(p0, lp({ 204.0f, 472.0f }, {  66.0f, 520.0f }), lp({ 222.0f, 554.0f }, {  74.0f, 602.0f }), p1);
+            gp.AddBezier(p1, lp({ 356.0f, 554.0f }, { 226.0f, 600.0f }), lp({ 358.0f, 478.0f }, { 274.0f, 544.0f }), p2);
+        };
+        build(open);
+        build(closed);
+        closed.CloseFigure();
