+        ctx.move(to: CGPoint(x: 591, y: 596)); ctx.addLine(to: CGPoint(x: 591, y: 632))
+        ctx.move(to: CGPoint(x: 636, y: 598)); ctx.addLine(to: CGPoint(x: 636, y: 633))
