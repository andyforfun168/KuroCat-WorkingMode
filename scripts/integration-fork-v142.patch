+                { 498.0, 344.0 }, { 422.0, 356.0 }, { 404.0, 464.0 }, { 500.0, 446.0 },
+                { 420.0, 422.0 }, { 420.0, 452.0 }, { 446.0, 426.0 }, { 446.0, 454.0 }
+            };
