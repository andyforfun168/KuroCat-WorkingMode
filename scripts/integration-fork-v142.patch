+        V2ArmShape poseA = {
+            { 616.0, 344.0 }, { 618.0, 406.0 }, { 410.0, 368.0 },
+            { 544.0, 306.0 }, { 432.0, 306.0 }, { 406.0, 414.0 }, { 522.0, 414.0 },
