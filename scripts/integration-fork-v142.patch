+struct KeyboardSkinLibrary {
+    std::vector<KeyboardSkinSpec> skins; // sorted by name
+
+    static std::string directory() {
+        const char* xdg = std::getenv("XDG_CONFIG_HOME");
+        std::string base;
+        if (xdg && xdg[0] == '/') base = xdg;
+        else {
+            const char* home = std::getenv("HOME");
