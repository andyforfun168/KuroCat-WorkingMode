+        onSettingsChanged?()
+    }
+
+    @objc private func onRotationChanged() {
+        var deg = CGFloat(rotSlider.doubleValue)
+        for snap in [-180.0, -90.0, 0.0, 90.0, 180.0] as [CGFloat] {
+            if abs(deg - snap) < 4.0 { deg = snap; break }
