+        // Smooth Disney choreographed morph between Video 2 Desk Scene and Video 1 Mochi Loaf!
+        if (loafS < 0.99) {
+            drawDouniV2InCanvas(cr, physics, skin, kbSkin, eyeTheme, marquee, loafS);
+        }
+
+        if (loafS > 0.01) {
+            drawDouniV1LoafInCanvas(cr, physics, skin, loafS);
+        }
