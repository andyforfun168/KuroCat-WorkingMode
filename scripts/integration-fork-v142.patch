+        // Arrival slide finishes by m = 0.64, then playful mochi bounce-settle overshoots flat and rebounds to 1.0!
+        double arrive = smoothstepD(0.30, 0.64, m);
+        double settlePhase = std::clamp((m - 0.52) / 0.48, 0.0, 1.0);
