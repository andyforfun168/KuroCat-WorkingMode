+        V2ArmShape poseB = {
+            { 626.0, 344.0 }, { 608.0, 382.0 }, { 422.0, 294.0 },
+            { 564.0, 278.0 }, { 458.0, 226.0 }, { 416.0, 344.0 }, { 518.0, 350.0 },
