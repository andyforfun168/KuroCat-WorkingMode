+            }
+            ctx.restoreGState()
+        }
+        for mark in skin.marks where mark.space == .head || mark.space == .skull {
+            let map: (CGPoint) -> CGPoint = mark.space == .skull ? skullMap : (isMilkMark(mark) ? headWhiteMap : headMap)
+            drawMark(in: ctx, mark, map: map)
+        }
+        ctx.restoreGState()
+
+        // Delicate lower chin depth stroke ONLY (so head reads cleanly in front without cutting a hard ring through Classic Black!)
+        ctx.saveGState()
+        ctx.setStrokeColor(isBlackRim
+            ? NSColor(calibratedWhite: 1.0, alpha: 0.26).cgColor
+            : (pal.outline?.ns.cgColor ?? NSColor(calibratedRed: 0.18, green: 0.15, blue: 0.12, alpha: 0.20).cgColor))
+        ctx.setLineWidth(isBlackRim ? 1.15 : (pal.outline != nil ? 1.5 : 1.0))
+        ctx.move(to: CGPoint(x: headCenter.x - cheekHalfW * 0.82, y: headCenter.y + cheekY + 12 * hs))
+        ctx.addCurve(to: CGPoint(x: headCenter.x + cheekHalfW * 0.82, y: headCenter.y + cheekY + 12 * hs),
+                     control1: CGPoint(x: headCenter.x - cheekHalfW * 0.45, y: headCenter.y + chinY + 2 * hs),
+                     control2: CGPoint(x: headCenter.x + cheekHalfW * 0.45, y: headCenter.y + chinY + 2 * hs))
+        ctx.strokePath()
+        ctx.restoreGState()
+
+        // 7. Native KuroCat Face Features: OWN authentic eyes (brief half-lidded startle -> wide pleading eyes with 2 catchlights), nose, mouth & whiskers!
+        drawHeadFeatures(
+            in: ctx,
+            center: headCenter,
+            physics: physics,
+            eyeTheme: eyeTheme,
+            skin: skin,
+            scruffStartle: startle,
+            scruffWide: 1.0 - startle
+        )
+
+        // 8. Skin stickers / decorations stay anchored cleanly to the lifted cat's head, neck, and whipping tail tip!
+        if !skin.decorations.isEmpty {
+            let dragNeck = CGPoint(x: headCenter.x + 2, y: headCenter.y + chinY + 2 * hs)
+            drawDecorations(in: ctx, seatX: backCenter.x, seatY: backCenter.y + 30, head: headCenter, physics: physics, skin: skin,
+                            neckOverride: dragNeck, tailTipOverride: tailTip)
+        }
+
+        ctx.restoreGState()
+    }
 }
diff --git a/Sources/KeyMap.swift b/Sources/KeyMap.swift
index 36b6cca..51f5360 100644
--- a/Sources/KeyMap.swift
+++ b/Sources/KeyMap.swift
@@ -452,4 +452,47 @@ enum KeyboardLayout {
         }
         return canvasPoint(u: 0.5, v: 0.5)
     }
+
+    /// Bilinear interpolation on Xiao Douni Video 2's angled hand-drawn keyboard surface (`u` left→right, `v` top→bottom in 832x720 V2Space).
+    static func v2KbPoint(u: CGFloat, v: CGFloat) -> CGPoint {
+        let tl = CGPoint(x: 242, y: 336)
+        let tr = CGPoint(x: 782, y: 446)
+        let br = CGPoint(x: 584, y: 586)
+        let bl = CGPoint(x: 28, y: 440)
+        let topX = tl.x + (tr.x - tl.x) * u
+        let topY = tl.y + (tr.y - tl.y) * u
+        let botX = bl.x + (br.x - bl.x) * u
+        let botY = bl.y + (br.y - bl.y) * u
+        return CGPoint(x: topX + (botX - topX) * v, y: topY + (botY - topY) * v)
+    }
+
+    /// Single source of truth mapping any PhysicalKey -> exact Video 2 keyboard cell `(row, col)` and V2Space center point.
+    static func v2KeyCellInfo(for key: PhysicalKey) -> (row: Int, col: Int, center: CGPoint) {
+        let wellU0: CGFloat = 0.31, wellU1: CGFloat = 0.95
+        let wellV0: CGFloat = 0.11, wellV1: CGFloat = 0.87
+        let vk = key.visualKey
+        if vk == .space {
+            let su = wellU0 + (wellU1 - wellU0) * (4.0 / 8.0)
+            let sv = wellV0 + (wellV1 - wellV0) * (3.5 / 4.0)
+            return (3, 2, v2KbPoint(u: su, v: sv))
+        }
+        guard let cap = lookup[vk] else {
+            let su = wellU0 + (wellU1 - wellU0) * (3.5 / 8.0)
+            let sv = wellV0 + (wellV1 - wellV0) * (1.5 / 4.0)
+            return (1, 3, v2KbPoint(u: su, v: sv))
+        }
+        let normU = max(0, min(1, 1.0 - (cap.xUnits + cap.widthUnits * 0.5)))
+        let col = max(0, min(7, Int(normU * 7.99)))
+        var row = max(0, min(3, cap.row >= 3 ? 3 : cap.row))
+        if row == 3 && col >= 2 && col <= 5 {
+            row = 2
+        }
+        let su = wellU0 + (wellU1 - wellU0) * ((CGFloat(col) + 0.5) / 8.0)
+        let sv = wellV0 + (wellV1 - wellV0) * ((CGFloat(row) + 0.5) / 4.0)
+        return (row, col, v2KbPoint(u: su, v: sv))
+    }
+
+    static func v2KeyCellCenter(for key: PhysicalKey) -> CGPoint {
+        v2KeyCellInfo(for: key).center
+    }
 }
