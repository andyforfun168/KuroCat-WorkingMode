+        size_t pos = 0;
+        while ((pos = data.find(needle, pos)) != std::string::npos) {
+            size_t p = pos + needle.size();
+            if (p < data.size() && std::isdigit((unsigned char)data[p])) {
+                size_t e = p;
+                while (e < data.size() && (std::isdigit((unsigned char)data[e]) || data[e] == '.')) e++;
