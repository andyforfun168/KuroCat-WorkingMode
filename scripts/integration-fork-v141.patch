+    private static func drawKeyboardKey(_ key: KeyboardKeyArtwork, in ctx: CGContext, glow: CGFloat,
+                                        glowColor: NSColor, backlight: KeyboardMarquee? = nil) {
+        if backlight == nil, glow == 0, let resting = key.resting {
