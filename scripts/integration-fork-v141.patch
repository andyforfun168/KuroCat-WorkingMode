+    private static func skinMark(_ m: CoatMark) -> SkinMark {
+        SkinMark(space: m.skull ? .skull : (m.head ? .head : .body), stroke: m.width != 0, width: m.width,
+                 color: .hex(m.rgb, m.alpha), points: m.points, clipToBib: m.clipToBib)
